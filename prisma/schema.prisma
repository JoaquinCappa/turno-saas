generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ARQUITECTURA MULTI-TENANT
// Todas las entidades principales deben pertenecer a un Business.
// -----------------------------------------------------------------------------

model Business {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  timezone      String   @default("America/Argentina/Buenos_Aires")
  description   String?
  phone         String?
  email         String?
  address       String?
  logoUrl       String?
  coverImageUrl String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  services      Service[]
  professionals Professional[]
  customers     Customer[]
  businessHours BusinessHour[]
  blockedTimes  BlockedTime[]
  bookings      Booking[]
}

model User {
  id         String   @id @default(cuid())
  businessId String
  name       String?
  email      String   @unique
  password   String
  role       Role     @default(STAFF)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

model Professional {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id])
  bookings Booking[]

  @@index([businessId])
}

model Service {
  id         String   @id @default(cuid())
  businessId String
  name       String
  duration   Int // En minutos
  price      Decimal  @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id])
  bookings Booking[]

  @@index([businessId])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id])
  bookings Booking[]

  @@index([businessId])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model BusinessHour {
  id          String    @id @default(cuid())
  businessId  String
  dayOfWeek   DayOfWeek
  startMinute Int // En minutos desde medianoche (ej. 09:00 = 540)
  endMinute   Int // En minutos desde medianoche (ej. 13:00 = 780)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, dayOfWeek])
}

model BlockedTime {
  id          String   @id @default(cuid())
  businessId  String
  date        DateTime @db.Date // Representa el día calendario local de la excepción
  startMinute Int // 0 a 1440. Si es todo el día, 0 a 1440
  endMinute   Int // 0 a 1440
  title       String? // Ej. "Feriado", "Vacaciones"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, date])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Booking {
  id             String @id @default(cuid())
  businessId     String
  customerId     String
  serviceId      String
  professionalId String

  // Instantes exactos (UTC)
  startAt DateTime
  endAt   DateTime

  // Snapshots para integridad histórica
  serviceName     String
  serviceDuration Int // En minutos
  servicePrice    Decimal @db.Decimal(10, 2)

  status BookingStatus @default(PENDING)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business     Business     @relation(fields: [businessId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])

  // Índices para búsquedas de disponibilidad y solapamientos
  @@index([businessId, professionalId, startAt, endAt])
  @@index([businessId, customerId])
}
